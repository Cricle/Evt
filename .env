NODE_VERSION=22-alpine
RUST_VERSION=rust:alpine3.22
ALPINE_VERSION=3.22
VITE_HOST=http://127.0.0.1:8008
NPM_REGISTRY=https://mirrors.tuna.tsinghua.edu.cn/npm/

DOCKER_IMAGE=bitbus/paopao-ce
DOCKER_VERSION=dev

MYSQL_DATABASE=paopao
MYSQL_USER=paopao
MYSQL_PASSWORD=paopao
MYSQL_PORT=3306

PAOPAO_HTTP_PORT=8008
PAOPAO_GRPC_PORT=18020
PAOPAO_DATABASE_URL=mysql://paopao:paopao@db:3306/paopao
PAOPAO_JWT_SECRET=change-me-in-production
PAOPAO_STORAGE_LOCAL_DIR=/app/custom/data/attachments
